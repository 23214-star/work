print("คืนนี้จะได้นอนกี่โมงวะ 💀")

homework = int(input("การบ้านเหลือกี่วิชา: "))
phone = input("ตอนนี้ติดโทรศัพท์ไหม (ติด/ไม่ติด): ")
energy = int(input("พลังชีวิตตอนนี้ 1-10: "))

if homework == 0 and phone == "ไม่ติด":
    print("คืนนี้รอดแล้ว ไปนอนได้เลย")

elif homework >= 3 and phone == "ติด":
    print("บอกเลยคืนนี้ยาว 🌚")

elif energy <= 3:
    print("งานก็ต้องทำ แต่ร่างกายไม่ไหวแล้ว")

else:
    print("ยังพอมีหวัง รีบทำงานก่อนจะดึก")

print("สู้ชีวิตต่อไปเพื่อน 🫡")
